---
import Icon from '@components/Icon.astro';

type Props = { block: any; siteConfig: any; services: any[]; lang?: 'en' | 'es' };
const { block, siteConfig, services = [], lang = 'en' } = Astro.props;
const es = lang === 'es';
const t = {
  phone: es ? 'Teléfono' : 'Phone',
  email: es ? 'Correo' : 'Email',
  office: es ? 'Oficina' : 'Office',
  scan: es
    ? 'Escanea el código con la cámara del móvil, o pulsa abajo para escribirnos al instante.'
    : 'Scan the code with your phone camera, or tap below to message us instantly.',
  quick: es
    ? 'Escríbenos por WhatsApp y te respondemos enseguida.'
    : 'Message us on WhatsApp for a quick reply.',
  chat: es ? 'Escríbenos por WhatsApp' : 'Chat on WhatsApp',
  fullName: es ? 'Nombre completo' : 'Full name',
  emailLabel: es ? 'Correo electrónico' : 'Email',
  phoneLabel: es ? 'Teléfono' : 'Phone',
  service: es ? 'Servicio de interés' : 'Service of interest',
  selectService: es ? 'Elige un servicio…' : 'Select a service…',
  help: es ? '¿En qué podemos ayudarte?' : 'How can we help?',
  send: es ? 'Enviar por WhatsApp' : 'Send via WhatsApp',
  note: es
    ? 'Se abre WhatsApp con tus datos listos para enviar. Respondemos en menos de 24 horas.'
    : 'Opens WhatsApp with your details ready to send. We reply within 24 hours.',
  phName: es ? 'Ana Ruiz' : 'Jane Doe',
  phEmail: es ? 'ana@correo.com' : 'jane@email.com',
  phMsg: es ? 'Cuéntanos un poco sobre tu proyecto…' : 'Tell us a bit about your project…',
  waGreet: es ? 'Hola LNH & Partner, soy' : "Hi LNH & Partner, I'm",
  waService: es ? 'Servicio' : 'Service',
  waPhone: es ? 'Teléfono' : 'Phone',
  waEmail: es ? 'Correo' : 'Email',
  fallback: es
    ? '¿No se abrió WhatsApp? Escríbenos a'
    : "Didn't WhatsApp open? Email us at",
};

const whatsappHref =
  siteConfig?.whatsappHref ||
  'https://wa.me/17866580795?text=Hi%20LNH%20%26%20Partner%2C%20I%27d%20like%20to%20request%20a%20quote.';

// Number the enquiry form hands off to. Parsed from the WhatsApp link so there
// is only ever one place to change it.
const whatsappNumber = whatsappHref.match(/wa\.me\/(\d+)/)?.[1] || '17866580795';

// Optional: once a real Formspree form exists, set `formspreeId` on the contact
// block in content.json and the form will also deliver a copy by email.
const formspreeId =
  block?.formspreeId && block.formspreeId !== 'your-form-id' ? block.formspreeId : '';
---

<section id="contact" class="section relative overflow-hidden bg-navy-950 text-white">
  <div class="absolute inset-x-0 top-0 h-px bg-gold-gradient opacity-50"></div>
  <div class="absolute -right-32 -top-32 -z-10 h-96 w-96 rounded-full bg-gold-500/10 blur-3xl"></div>

  <div class="container-x grid gap-16 lg:grid-cols-2 lg:items-start">
    <div class="reveal">
      {block?.eyebrow && <p class="eyebrow text-gold-400">{block.eyebrow}</p>}
      <h2 class="heading-section mt-4 text-balance text-white">
        {block?.headingStart}
        {block?.headingAccent && <> <span class="text-gold-400">{block.headingAccent}</span></>}
      </h2>
      {block?.lead && <p class="lead mt-6 text-white/70">{block.lead}</p>}

      <ul class="mt-10 space-y-5">
        {siteConfig?.phone && (
          <li class="flex items-start gap-4">
            <span class="inline-flex h-11 w-11 items-center justify-center rounded-lg bg-gold-500/15 text-gold-400">
              <Icon name="phone" class="h-5 w-5" />
            </span>
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-white/50">
                {t.phone}
              </p>
              <a href={siteConfig.phoneHref || `tel:${siteConfig.phone}`} class="mt-1 block text-lg font-semibold transition-colors hover:text-gold-300">
                {siteConfig.phone}
              </a>
            </div>
          </li>
        )}
        {siteConfig?.email && (
          <li class="flex items-start gap-4">
            <span class="inline-flex h-11 w-11 items-center justify-center rounded-lg bg-gold-500/15 text-gold-400">
              <Icon name="mail" class="h-5 w-5" />
            </span>
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-white/50">
                {t.email}
              </p>
              <a href={siteConfig.emailHref || `mailto:${siteConfig.email}`} class="mt-1 block text-lg font-semibold transition-colors hover:text-gold-300">
                {siteConfig.email}
              </a>
            </div>
          </li>
        )}
        {siteConfig?.address && (
          <li class="flex items-start gap-4">
            <span class="inline-flex h-11 w-11 items-center justify-center rounded-lg bg-gold-500/15 text-gold-400">
              <Icon name="pin" class="h-5 w-5" />
            </span>
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-white/50">
                {t.office}
              </p>
              <p class="mt-1 text-lg font-semibold">{siteConfig.address}</p>
            </div>
          </li>
        )}
      </ul>

      <!-- WhatsApp: QR on desktop, tap button on phones -->
      <div class="mt-10 rounded-2xl border border-white/10 bg-white/5 p-5 sm:flex sm:items-center sm:gap-5">
        <img
          src="/assets/whatsapp-qr.png"
          alt="Scan to chat with LNH & Partner on WhatsApp"
          width="128"
          height="128"
          class="hidden h-28 w-28 shrink-0 rounded-lg bg-white p-1.5 sm:block"
        />
        <div class="min-w-0">
          <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-gold-400">
            <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            WhatsApp
          </p>
          <p class="mt-2 text-sm text-white/70">
            <span class="hidden sm:inline">{t.scan}</span>
            <span class="sm:hidden">{t.quick}</span>
          </p>
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex w-full items-center justify-center gap-2 rounded-full bg-[#25D366] px-5 py-3 font-semibold text-white transition hover:bg-[#1ebe5d] sm:w-auto"
          >
            <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            {t.chat}
          </a>
        </div>
      </div>
    </div>

    <form
      id="contact-form"
      class="reveal rounded-2xl border border-white/10 bg-white/5 p-8 backdrop-blur-sm md:p-10"
      data-wa-number={whatsappNumber}
      data-wa-greet={t.waGreet}
      data-wa-service={t.waService}
      data-wa-phone={t.waPhone}
      data-wa-email={t.waEmail}
      data-formspree-id={formspreeId}
      novalidate
    >
      <div class="grid gap-5 sm:grid-cols-2">
        <label class="block">
          <span class="text-xs font-semibold uppercase tracking-[0.15em] text-white/60">{t.fullName}</span>
          <input type="text" name="name" required
            class="mt-2 w-full rounded-md border border-white/15 bg-white/5 px-4 py-3 text-white placeholder-white/30 outline-none ring-gold-400 transition focus:border-gold-400 focus:ring-2"
            placeholder={t.phName} />
        </label>
        <label class="block">
          <span class="text-xs font-semibold uppercase tracking-[0.15em] text-white/60">{t.emailLabel}</span>
          <input type="email" name="email" required
            class="mt-2 w-full rounded-md border border-white/15 bg-white/5 px-4 py-3 text-white placeholder-white/30 outline-none ring-gold-400 transition focus:border-gold-400 focus:ring-2"
            placeholder={t.phEmail} />
        </label>
        <label class="block">
          <span class="text-xs font-semibold uppercase tracking-[0.15em] text-white/60">{t.phoneLabel}</span>
          <input type="tel" name="phone"
            class="mt-2 w-full rounded-md border border-white/15 bg-white/5 px-4 py-3 text-white placeholder-white/30 outline-none ring-gold-400 transition focus:border-gold-400 focus:ring-2"
            placeholder={siteConfig?.phone || ''} />
        </label>
        <label class="block">
          <span class="text-xs font-semibold uppercase tracking-[0.15em] text-white/60">{t.service}</span>
          <select name="service"
            class="mt-2 w-full rounded-md border border-white/15 bg-white/5 px-4 py-3 text-white outline-none ring-gold-400 transition focus:border-gold-400 focus:ring-2">
            <option class="bg-navy-900" value="">{t.selectService}</option>
            {services.map((s: any) => <option class="bg-navy-900" value={s.title}>{s.title}</option>)}
          </select>
        </label>
      </div>

      <label class="mt-5 block">
        <span class="text-xs font-semibold uppercase tracking-[0.15em] text-white/60">{t.help}</span>
        <textarea name="message" rows="5" required
          class="mt-2 w-full rounded-md border border-white/15 bg-white/5 px-4 py-3 text-white placeholder-white/30 outline-none ring-gold-400 transition focus:border-gold-400 focus:ring-2"
          placeholder={t.phMsg}></textarea>
      </label>

      <button id="contact-submit" type="submit" disabled
        class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-full bg-[#25D366] px-5 py-3 font-semibold text-white transition hover:bg-[#1ebe5d] disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:bg-[#25D366]">
        <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        {t.send}
      </button>

      <p id="contact-fallback" class="mt-3 hidden text-center text-xs text-white/60">
        {t.fallback}{' '}
        <a href={siteConfig?.emailHref || `mailto:${siteConfig?.email}`} class="font-semibold text-gold-300 underline underline-offset-2">
          {siteConfig?.email}
        </a>
      </p>
      <p id="contact-feedback" class="mt-4 text-center text-xs text-white/40">
        {t.note}
      </p>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const btn = document.getElementById('contact-submit') as HTMLButtonElement | null;
  const feedback = document.getElementById('contact-feedback') as HTMLElement | null;

  if (form && btn && feedback) {
    const requiredFields = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]');

    function checkValidity() {
      const allFilled = Array.from(requiredFields).every((f) => f.value.trim() !== '');
      btn!.disabled = !allFilled;
    }

    requiredFields.forEach((f) => f.addEventListener('input', checkValidity));

    // The enquiry is handed off to WhatsApp with every field pre-filled, so it
    // lands on a phone the moment the visitor hits send. If a Formspree id is
    // configured, a copy is emailed too — best effort, never blocking.
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const data = new FormData(form);
      const value = (key: string) => String(data.get(key) ?? '').trim();

      const name = value('name');
      const email = value('email');
      const phone = value('phone');
      const service = value('service');
      const message = value('message');

      const d = form.dataset;
      const lines = [`${d.waGreet || "Hi LNH & Partner, I'm"} ${name}.`];
      if (service) lines.push(`${d.waService || 'Service'}: ${service}`);
      if (phone) lines.push(`${d.waPhone || 'Phone'}: ${phone}`);
      if (email) lines.push(`${d.waEmail || 'Email'}: ${email}`);
      if (message) lines.push('', message);

      const number = form.dataset.waNumber || '17866580795';
      const waUrl = `https://wa.me/${number}?text=${encodeURIComponent(lines.join('\n'))}`;

      // Open synchronously — a popup blocked by an async gap loses the lead.
      const opened = window.open(waUrl, '_blank', 'noopener,noreferrer');
      if (!opened) window.location.href = waUrl;

      const formspreeId = form.dataset.formspreeId;
      if (formspreeId) {
        fetch(`https://formspree.io/f/${formspreeId}`, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        }).catch(() => {});
      }

      document.getElementById('contact-fallback')?.classList.remove('hidden');
      feedback.textContent = 'Opening WhatsApp with your message ready to send…';
      feedback.classList.remove('text-white/40', 'text-red-400');
      feedback.classList.add('text-gold-400');
    });
  }
</script>
