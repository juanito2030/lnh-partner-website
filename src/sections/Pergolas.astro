---
import Icon from '@components/Icon.astro';
import { imageSrc } from '@lib/sanity';

type Props = { block: any; lang?: 'en' | 'es' };
const { block, lang = 'en' } = Astro.props;
const es = lang === 'es';
const t = {
  pergolas: es ? 'Pérgolas y cabañas' : 'Pergolas & Cabanas',
  pergolasDesc: es
    ? 'Diseños a la medida para cada propiedad — aluminio, madera dura y configuraciones motorizadas.'
    : 'Custom designs tailored to each property — aluminum, hardwood, and motorized configurations.',
  sunrooms: es ? 'Sunrooms y paredes de vidrio' : 'Sunrooms & Glass Walls',
  playLabel: es ? 'Reproducir vídeo' : 'Play video',
  sunroomsDesc: es
    ? 'Cerramientos de vidrio corredizo que convierten cualquier patio en un espacio para todo el año.'
    : 'Glass sliding wall enclosures that turn any patio into a four-season space.',
};
const features = block?.features ?? [];
const imgUrl = block?.image ? imageSrc(block.image, 1400) : '';
---

<section id="pergolas" class="section relative overflow-hidden bg-navy-900 text-white">
  <div class="absolute inset-x-0 top-0 h-px bg-gold-gradient opacity-50"></div>

  <div class="container-x">
    <div class="reveal mx-auto max-w-3xl text-center">
      {block?.eyebrow && <p class="eyebrow justify-center text-gold-400">{block.eyebrow}</p>}
      <h2 class="heading-section mt-4 text-balance text-white">
        {block?.headingStart}
        {block?.headingAccent && <> <span class="text-gold-400">{block.headingAccent}</span></>}
      </h2>
      {block?.lead && <p class="lead mt-6 text-white/70">{block.lead}</p>}
    </div>

    <div class="mt-14 grid gap-8 lg:grid-cols-2 reveal">
      <div class="group relative overflow-hidden rounded-2xl bg-navy-950 shadow-card">
        <!-- The two clips arrive at different native ratios (1:1 and 16:9).
             Both frames are 4:3 so the cards line up, which crops each a
             little rather than cropping one a lot. -->
        <div class="relative aspect-[4/3] w-full">
          <video
            class="video-lnh h-full w-full object-cover"
            poster="/assets/images/poster-pergola.jpg"
            preload="none"
            playsinline
          >
            <source src="/assets/videos/pergola.mp4" type="video/mp4" />
          </video>
          <button
            type="button"
            class="video-play absolute inset-0 flex items-center justify-center bg-navy-950/25 transition hover:bg-navy-950/10"
            aria-label={t.playLabel}
          >
            <span class="flex h-16 w-16 items-center justify-center rounded-full bg-white/95 shadow-lg transition group-hover:scale-105">
              <svg viewBox="0 0 24 24" class="ml-1 h-6 w-6 fill-navy-900"><path d="M8 5v14l11-7z"/></svg>
            </span>
          </button>
        </div>
        <div class="p-6">
          <span class="inline-block rounded-full bg-gold-500/15 px-3 py-1 text-xs font-semibold uppercase tracking-[0.15em] text-gold-300">
            {t.pergolas}
          </span>
          <p class="mt-3 text-sm leading-relaxed text-white/70">
            {t.pergolasDesc}
          </p>
        </div>
      </div>

      <div class="group relative overflow-hidden rounded-2xl bg-navy-950 shadow-card">
        <div class="relative aspect-[4/3] w-full">
          <video
            class="video-lnh h-full w-full object-cover"
            poster="/assets/images/poster-sunroom.jpg"
            preload="none"
            playsinline
          >
            <source src="/assets/videos/sunroom.mp4" type="video/mp4" />
          </video>
          <button
            type="button"
            class="video-play absolute inset-0 flex items-center justify-center bg-navy-950/25 transition hover:bg-navy-950/10"
            aria-label={t.playLabel}
          >
            <span class="flex h-16 w-16 items-center justify-center rounded-full bg-white/95 shadow-lg transition group-hover:scale-105">
              <svg viewBox="0 0 24 24" class="ml-1 h-6 w-6 fill-navy-900"><path d="M8 5v14l11-7z"/></svg>
            </span>
          </button>
        </div>
        <div class="p-6">
          <span class="inline-block rounded-full bg-gold-500/15 px-3 py-1 text-xs font-semibold uppercase tracking-[0.15em] text-gold-300">
            {t.sunrooms}
          </span>
          <p class="mt-3 text-sm leading-relaxed text-white/70">
            {t.sunroomsDesc}
          </p>
        </div>
      </div>
    </div>

    <div class="mt-14 grid gap-10 lg:grid-cols-3 lg:items-center reveal">
      <ul class="space-y-4 lg:col-span-2">
        {
          features.map((f: string) => (
            <li class="flex items-start gap-3 text-base text-white/85">
              <span class="mt-0.5 inline-flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-gold-500/20 text-gold-400">
                <Icon name="check" class="h-3.5 w-3.5" />
              </span>
              {f}
            </li>
          ))
        }
      </ul>
      {block?.ctaLabel && (
        <a href={block.ctaHref || '#contact'} class="btn-primary justify-self-start lg:justify-self-end">
          {block.ctaLabel}
          <Icon name="arrowRight" class="h-4 w-4" />
        </a>
      )}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.video-play').forEach((btn) => {
    btn.addEventListener('click', () => {
      const video = btn.parentElement?.querySelector('video');
      if (!video) return;
      video.controls = true;
      video.play();
      btn.remove();
    });
  });
</script>
